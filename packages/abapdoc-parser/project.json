{
  "name": "abapdoc-parser",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/abapdoc-parser/src",
  "projectType": "library",
  "targets": {
    "build": {
      "command": "npm run build:js && npm run build:dts",
      "options": {
        "cwd": "packages/abapdoc-parser"
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/abapdoc-parser/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/abapdoc-parser"
      ],
      "options": {
        "configFile": "packages/abapdoc-parser/vite.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": [
    "scope:parser"
  ]
}