{
  "name": "abapdoc-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/abapdoc-cli/src",
  "projectType": "library",
  "targets": {
    "build": {
      "command": "tsdown",
      "options": {
        "cwd": "packages/abapdoc-cli"
      },
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["build-deps"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/abapdoc-cli/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config {projectRoot}/vite.config.ts",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["build", "^build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": ["scope:cli"]
}
