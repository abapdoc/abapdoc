{
  "name": "abapdoc-renderer-mdx",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/abapdoc-renderer-mdx/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/abapdoc-renderer-mdx/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/packages/abapdoc-renderer-mdx"],
      "options": {
        "configFile": "packages/abapdoc-renderer-mdx/vite.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": ["scope:renderer"]
}
