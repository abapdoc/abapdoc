{
  "name": "abapdoc-renderer-registry",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/abapdoc-renderer-registry/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/abapdoc-renderer-registry/dist",
        "main": "packages/abapdoc-renderer-registry/src/index.ts",
        "tsConfig": "packages/abapdoc-renderer-registry/tsconfig.lib.json",
        "rootDir": "packages/abapdoc-renderer-registry/src",
        "generatePackageJson": false,
        "assets": [
          {
            "input": "./packages/abapdoc-renderer-registry/src",
            "glob": "**/*.d.ts",
            "output": "."
          }
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/abapdoc-renderer-registry/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config {projectRoot}/vite.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": ["scope:renderer"]
}
