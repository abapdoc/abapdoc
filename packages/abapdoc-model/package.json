{
  "name": "@abapdoc/model",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema.json": "./dist/json-schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "tsx scripts/dump-json-schema.ts"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/abapdoc-model/dist",
          "main": "packages/abapdoc-model/src/index.ts",
          "tsConfig": "packages/abapdoc-model/tsconfig.lib.json",
          "rootDir": "packages/abapdoc-model/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/abapdoc-model/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "zod-to-json-schema": "^3.25.2"
  }
}